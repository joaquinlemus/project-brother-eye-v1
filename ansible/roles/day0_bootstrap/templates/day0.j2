{# =====================================================================================
   Day-0: configuración mínima para que un router nuevo acepte SSH desde la plataforma.
   Basada en la configuración real de R1. Se aplica por consola (EVE-NG) o pegándola a mano.
   Después de esto, todo lo demás lo configura Ansible por SSH (roles fvrf, base, crypto...).

   Variables:
     inventory_hostname   R7-ANT-07                    (IPAM)
     ansible_host         172.16.0.7                   (IPAM, underlay en la VRF INET)
     underlay_mask        255.255.255.0
     ansible_user         ansible
     ansible_password     clave del usuario (Secrets Manager); IOS la guarda como hash
     mgmt_servers.jump_host / .ntp   172.16.0.20       (Ubuntu: Zabbix + punto de entrada)
   ===================================================================================== #}
hostname {{ inventory_hostname }}
no ip domain lookup
ip domain name {{ domain_name }}
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
! --- Underlay en front-door VRF: aísla la tabla de Internet del overlay ---
vrf definition {{ fvrf_name }}
 address-family ipv4
 exit-address-family
!
interface {{ wan_interface }}
 description Underlay (FVRF {{ fvrf_name }})
 vrf forwarding {{ fvrf_name }}
 ip address {{ ansible_host }} {{ underlay_mask }}
 no shutdown
!
! --- Usuario local para Ansible (privilegio 15: entra directo a '#') ---
username {{ ansible_user }} privilege 15 secret {{ ansible_password }}
!
! --- SSH solo desde el servidor de gestión, por la VRF ---
ip ssh version 2
ip access-list standard MGMT
 permit {{ mgmt_servers.jump_host }}
 deny   any log
!
line vty 0 4
 access-class MGMT in vrf-also
 login local
 transport input ssh
 exec-timeout 15 0
!
! --- Hora: el NTP también vive en la VRF (sin 'vrf', el router lo busca en la tabla global) ---
ntp server vrf {{ fvrf_name }} {{ mgmt_servers.ntp }}
