# /opt/xyz/portal/portal.env  (chmod 600; lo crea install.sh con valores aleatorios)
DATABASE_URL=postgresql://portal:CAMBIAR@127.0.0.1:5432/portal
APP_SECRET_KEY=CAMBIAR-64-caracteres-hex
COOKIE_SECURE=true
COOKIE_PATH=/portal_heladeria
ROOT_PATH=/portal_heladeria
XYZ_BASE=/opt/xyz
JOB_TIMEOUT=1800
# Zabbix: solo lectura desde el portal (el alta/baja del host la hace Ansible)
ZABBIX_URL=http://172.16.0.20/zabbix
ZABBIX_API_TOKEN=
# Conectividad: el worker prueba cada router (TCP 22 y ping) por WireGuard
HEALTH_INTERVAL=60            # segundos entre pruebas (0 = desactivado)
HEALTH_FAILURES=2             # pruebas fallidas seguidas para marcar "No disponible"
OFFLINE_PROMPT_MINUTES=30     # minutos sin respuesta antes de preguntar al administrador
HUB_HOSTS=R1=172.16.0.1,R2=172.16.0.2   # si ningún hub responde, se asume caído el enlace al lab
TEAM_BIRTH_MONTH=12
TEAM_BIRTH_DAY=28
# Infraestructura que ningún sitio puede pisar: el portal calcula qué Site ID chocan
# (con D=28: R20 por 172.16.0.20 y R71 porque su LAN sería 10.99.0.0/24)
RESERVED_UNDERLAY_HOSTS=172.16.0.20
RESERVED_NETWORKS=10.99.0.0/24,10.254.0.0/24
