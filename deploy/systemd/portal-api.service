[Unit]
Description=Portal Heladería Leche de Cabra - API (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=__USER__
Group=__USER__
EnvironmentFile=/opt/xyz/portal/portal.env
WorkingDirectory=/opt/xyz/portal/backend
ExecStart=/opt/xyz/portal/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
